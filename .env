# ==============================================
# FesseBook - Configuration
# ==============================================
# Copiez ce fichier vers .env et remplissez les valeurs

# ==============================================
# NOTION CONFIGURATION
# ==============================================
# Token d'intégration Notion (obtenu depuis https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IDs des bases de données Notion
NOTION_DB_PROFILES=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_DB_CALENDAR=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_DB_PERFORMANCE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==============================================
# GMAIL CONFIGURATION
# ==============================================
# Chemin vers le fichier credentials OAuth2 de Google
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Email expéditeur
GMAIL_SENDER_EMAIL=marketing@votreentreprise.com

# ==============================================
# HOOTSUITE CONFIGURATION (optionnel)
# ==============================================
HOOTSUITE_API_KEY=
HOOTSUITE_API_SECRET=

# ==============================================
# APPLICATION SETTINGS
# ==============================================
# Niveau de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone pour la planification
TIMEZONE=Europe/Paris

# Délai avant rappel de publication (en heures)
PUBLICATION_REMINDER_HOURS=2

# Délai pour demander les métriques (en heures après publication)
METRICS_REQUEST_DELAY_HOURS=48

# ==============================================
# CONTENT GENERATION (optionnel - pour IA)
# ==============================================
# Si vous utilisez une IA pour générer du contenu
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
